# Токен от @BotFather для нового @vip_bot
BOT_TOKEN=

# Тот же DATABASE_URL что у основного api (Reference в Railway)
DATABASE_URL=

# Anthropic API key — получить на console.anthropic.com → API Keys
# На этапе 1 не нужен (без AI), но указать сейчас чтобы потом не забыть
ANTHROPIC_API_KEY=

# Кто получает уведомления об ошибках/новых VIP-юзерах
ADMIN_IDS=7853415163

# Лимит сигналов в день и часовой пояс для daily reset
SIGNALS_PER_DAY=5
RESET_HOUR_UTC=9
# RESET_HOUR_UTC=9 = 12:00 MSK (UTC+3). Поменяй если нужен другой TZ.

# URL основного бота — для редиректа юзеров без депозита
MAIN_BOT_URL=https://t.me/tradenewpt_bot
